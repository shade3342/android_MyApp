<!-- 종이인형 레이어 0: 배경.
     모든 캐릭터 레이어는 같은 viewport(100 x 150)를 쓴다 → Box 로 겹치면 좌표가 자동 정렬.
     지금은 placeholder(단색 패널). 나중에 '방/배경' PNG 로 교체하면 됨. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="150dp"
    android:viewportWidth="100"
    android:viewportHeight="150">
    <path
        android:pathData="M0,0 L100,0 L100,150 L0,150 Z"
        android:fillColor="#FFEAF2FB" />
</vector>
